---
import { cms } from "../lib/cms";
import { getLang, localizePath, ui } from "../lib/i18n";
import TextLink from "./ui/TextLink.astro";

const lang = getLang(Astro.url);
const t = ui[lang].footer;

const settings = await cms.getSiteSettings(lang);
const areas = await cms.getPracticeAreas(lang);

const currentYear = new Date().getFullYear();
const footerLinkClass =
  "text-base leading-snug text-fg-on-inverse/85 transition-colors hover:text-fg-on-inverse";
---

<footer class="bg-surface-inverse text-fg-on-inverse">
  <div class="container-x py-20 md:py-28">
    <div class="grid grid-cols-1 gap-14 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-3">
        <a
          href={localizePath("/", lang)}
          class="inline-block"
          aria-label={ui[lang].a11y.homeLink(settings.name)}
        >
          <img
            src="/goni-abogados-logo.png"
            alt={settings.legalName}
            width="1000"
            height="320"
            class="h-10 w-auto brightness-0 invert md:h-12"
          />
        </a>
      </div>

      <div class="md:col-span-3">
        <p class="eyebrow text-fg-on-inverse/55">{t.practice}</p>
        <ul class="mt-6 space-y-3.5">
          {areas.slice(0, 5).map((area) => (
            <li>
              <a
                href={localizePath(`/areas-de-practica/${area.slug}`, lang)}
                class={footerLinkClass}
              >
                {area.title}
              </a>
            </li>
          ))}
          <li>
            <a
              href={localizePath("/areas-de-practica", lang)}
              class={footerLinkClass}
            >
              {t.viewAllAreas}
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="eyebrow text-fg-on-inverse/55">{t.firm}</p>
        <ul class="mt-6 space-y-3.5">
          <li>
            <a href={localizePath("/nosotros", lang)} class={footerLinkClass}>
              {ui[lang].nav.about}
            </a>
          </li>
          <li>
            <a href={localizePath("/contacto", lang)} class={footerLinkClass}>
              {ui[lang].nav.contact}
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="eyebrow text-fg-on-inverse/55">{t.contact}</p>
        <address class="mt-6 space-y-3.5 text-base not-italic leading-relaxed text-fg-on-inverse/85">
          <p>
            {settings.address.street}<br />
            {settings.address.city}, {settings.address.region}<br />
            {settings.address.country}
          </p>
          <p>
            <TextLink
              href={settings.address.mapsUrl}
              variant="inverse"
              size="md"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.viewOnMaps}
            </TextLink>
          </p>
          <p>
            <a href={`tel:${settings.phone.replace(/\s+/g, "")}`} class="transition-colors hover:text-fg-on-inverse">
              {settings.phone}
            </a><br />
            <a href={`mailto:${settings.email}`} class="transition-colors hover:text-fg-on-inverse">
              {settings.email}
            </a>
          </p>
        </address>
      </div>
    </div>

    <div class="mt-20 flex flex-col items-start justify-between gap-4 border-t border-line-on-inverse/15 pt-8 text-xs text-fg-on-inverse/55 md:flex-row md:items-center">
      <p>© {currentYear} {settings.legalName} {t.rights}</p>
    </div>
  </div>
</footer>
