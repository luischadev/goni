---
import Button from "./ui/Button.astro";
import { getLang, localizePath, ui } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  buttonLabel?: string;
  href?: string;
}

const lang = getLang(Astro.url);

const {
  title,
  description,
  buttonLabel = ui[lang].cta.defaultLabel,
  href = localizePath("/contacto", lang),
} = Astro.props;
---

<section class="scroll-background-section" data-scroll-background>
  <div class="container-x py-16 md:py-32">
    <div class="grid grid-cols-1 md:grid-cols-12">
      <div class="md:col-span-8">
        <h2
          class="font-display text-3xl md:text-5xl leading-[1.05] reveal reveal-from-top"
          data-scroll-text-reveal
        >
          {title}
        </h2>
        <p class="mt-4 md:mt-8 max-w-xl text-base md:text-lg text-fg-muted leading-relaxed reveal reveal-fade">
          {description}
        </p>
        <div class="mt-8 md:mt-10 reveal">
          <Button href={href}>{buttonLabel}</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initScrollBackgroundSections } from "../scripts/scroll-background";
  import { initScrollTextReveals } from "../scripts/scroll-text-reveal";

  initScrollBackgroundSections();
  initScrollTextReveals();
  document.addEventListener("astro:page-load", initScrollBackgroundSections);
  document.addEventListener("astro:page-load", initScrollTextReveals);
</script>
