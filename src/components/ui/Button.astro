---
import {
  buttonSizes,
  buttonVariants,
} from "../../lib/ui-classes";

type Variant = keyof typeof buttonVariants;
type Tone = keyof (typeof buttonVariants)["primary"];
type Size = keyof typeof buttonSizes;

interface Props {
  variant?: Variant;
  tone?: Tone;
  size?: Size;
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  showArrow?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  "aria-label"?: string;
  "aria-expanded"?: "true" | "false";
  "aria-controls"?: string;
  onclick?: string;
}

const {
  variant = "primary",
  tone = "default",
  size = variant === "primary" ? "md" : "none",
  href,
  type = "button",
  disabled = false,
  showArrow = true,
  class: className = "",
  target,
  rel,
  id,
  "aria-label": ariaLabel,
  "aria-expanded": ariaExpanded,
  "aria-controls": ariaControls,
  onclick,
} = Astro.props;

const classes = [
  buttonVariants[variant][tone],
  variant === "primary" ? buttonSizes[size] : "",
  className,
]
  .filter(Boolean)
  .join(" ");

const isLink = Boolean(href) && !disabled;
---

{
  isLink ? (
    <a
      href={href}
      class={classes}
      target={target}
      rel={rel}
      id={id}
      aria-label={ariaLabel}
    >
      <slot />
      {showArrow && <span class="button__arrow" aria-hidden="true">→</span>}
    </a>
  ) : (
    <button
      type={type}
      class={classes}
      data-button
      disabled={disabled}
      id={id}
      aria-label={ariaLabel}
      aria-expanded={ariaExpanded}
      aria-controls={ariaControls}
      onclick={onclick}
    >
      <span class="button__label">
        <slot />
      </span>
      <span class="button__spinner" aria-hidden="true"></span>
      {showArrow && <span class="button__arrow" aria-hidden="true">→</span>}
    </button>
  )
}

<style is:global>
  [data-button] {
    position: relative;
  }

  [data-button] .button__spinner {
    display: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: button-spin 0.7s linear infinite;
  }

  [data-button].is-loading {
    pointer-events: none;
  }

  [data-button].is-loading .button__label,
  [data-button].is-loading .button__arrow {
    opacity: 0;
  }

  [data-button].is-loading .button__spinner {
    display: block;
    position: absolute;
    inset: 0;
    margin: auto;
  }

  @keyframes button-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-button] .button__spinner {
      animation-duration: 1.2s;
    }
  }
</style>
