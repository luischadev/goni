---
import { Image } from "astro:assets";
import { getPracticeAreaHeroImage } from "../../lib/content";
import type { PracticeArea } from "../../lib/types";

interface Props {
  areas: PracticeArea[];
}

const { areas } = Astro.props;
---

<section
  aria-labelledby="practice-areas"
  class="practice-area-stack scroll-stack-section"
>
  <div class="container-x pt-16 md:pt-32 pb-12 md:pb-16">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-6">
        <p class="eyebrow reveal">Áreas de práctica</p>
        <h2 id="practice-areas" class="font-display text-3xl md:text-5xl mt-6 leading-[1.05] reveal">
          Servicios legales integrales para riesgos y controversias.
        </h2>
      </div>
      <div class="md:col-span-5 md:col-start-8 md:pt-4">
        <p class="text-base md:text-lg text-fg-muted leading-relaxed reveal">
          Prestamos asesoría legal especializada con eficiencia, calidad y atención
          personalizada, acompañando a nuestros clientes en la prevención de riesgos
          y en la solución de conflictos.
        </p>
      </div>
    </div>
  </div>

  <div class="container-x pb-16 md:pb-32">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-5 lg:gap-6">
      {
        areas.map((area) => {
          const heroImage = getPracticeAreaHeroImage(area.slug);

          return (
            <a
              href={`/areas-de-practica/${area.slug}`}
              class="group reveal relative block min-h-[28rem] overflow-hidden rounded-card bg-surface-inverse shadow-[0_24px_80px_rgba(15,24,34,0.08)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-line-strong md:min-h-[32rem]"
            >
              <div class="pointer-events-none absolute inset-0 media-skeleton media-skeleton--inverse" aria-hidden="true">
                <Image
                  src={heroImage.src}
                  alt=""
                  width={900}
                  height={1125}
                  format="webp"
                  loading="lazy"
                  data-skeleton
                  class="h-full w-full object-cover"
                />
                <div class="absolute inset-0 z-[2] bg-gradient-to-t from-surface-inverse/95 via-surface-inverse/62 to-surface-inverse/10"></div>
              </div>

              <div class="relative z-10 flex min-h-[28rem] flex-col justify-end p-6 text-fg-on-inverse sm:p-8 md:min-h-[32rem] md:p-10 lg:p-12">
                <h3 class="reveal reveal-from-top link-underline [text-decoration-line:underline] md:[text-decoration-line:none] md:group-hover:[text-decoration-line:underline] font-display text-3xl sm:text-4xl md:text-3xl lg:text-4xl leading-[1.04] tracking-[-0.03em] text-fg-on-inverse group-hover:text-fg-on-inverse-interaction">
                  {area.title}
                </h3>

                <p class="reveal reveal-fade mt-4 max-w-xl text-sm sm:text-base md:text-base lg:text-lg text-fg-on-inverse/85 leading-relaxed md:leading-snug">
                  {area.shortDescription}
                </p>

              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
