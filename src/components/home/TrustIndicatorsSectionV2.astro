---
/**
 * TrustIndicatorsSectionV2
 *
 * Grid que escala con scroll (zoom-out) en AMBOS breakpoints:
 *
 * Desktop — 4 cols × 3 filas:
 *   [   tl   ][   tr   ]         ← row 1
 *   [ L ][ VIDEO ][ R ]          ← row 2 (video en cols 2-3)
 *   [   bl   ][   br   ]         ← row 3
 *
 * Mobile — 2 cols × 3 filas, tarjetas circundantes con aspect-ratio 3:4:
 *   [ tl ][ tr ]                 ← row 1 (portrait 3:4)
 *   [   VIDEO   ]                ← row 2 (spans 2 cols, aspect 4:3)
 *   [ bl ][ br ]                 ← row 3 (portrait 3:4)
 *   (L y R ocultas en mobile)
 *
 * La animación arranca con el grid ampliado: el video central llena el
 * viewport. Con el scroll, el GRID COMPLETO escala hacia 1× revelando
 * las tarjetas circundantes. Después, los textos se desvanecen.
 */

const VIDEO_SRC =
  "https://pub-396ba7766f0a49cba86800f9d74523ad.r2.dev/8783391-hd_1920_1080_30fps.mp4";

const SURROUND_VIDEOS = [
  {
    class: "surround--tl",
    src: "https://pub-396ba7766f0a49cba86800f9d74523ad.r2.dev/4157778-hd_1920_1080_24fps.mp4",
  },
  {
    class: "surround--tr",
    src: "https://pub-396ba7766f0a49cba86800f9d74523ad.r2.dev/12028868_1920_1080_24fps.mp4",
  },
  {
    class: "surround--l",
    src: "https://pub-396ba7766f0a49cba86800f9d74523ad.r2.dev/8344449-uhd_3840_2160_30fps.mp4",
  },
  {
    class: "surround--r",
    src: "https://pub-396ba7766f0a49cba86800f9d74523ad.r2.dev/12984266_1920_1080_25fps.mp4",
  },
  {
    class: "surround--bl",
    src: "https://pub-396ba7766f0a49cba86800f9d74523ad.r2.dev/4292300-uhd_3840_2160_25fps.mp4",
  },
  {
    class: "surround--br",
    src: "https://pub-396ba7766f0a49cba86800f9d74523ad.r2.dev/15978611-uhd_3840_2160_30fps.mp4",
  },
] as const;

const HEADLINE = "+50 años de trayectoria";
const SUBLINE = "en el mercado de los seguros y reaseguros";
const PHRASE = `${HEADLINE} ${SUBLINE}`;
const headlineWords = HEADLINE.split(" ");
const sublineWords = SUBLINE.split(" ");
---

<section class="scroll-scene" data-scroll-scene>
  <div class="scroll-scene__stage" data-scene-stage>

    <div class="scroll-scene__grid" data-scene-grid>

      {SURROUND_VIDEOS.map(({ class: cardClass, src }) => (
        <div class={`scroll-scene__surround-card ${cardClass}`} data-scene-surround>
          <video
            class="scroll-scene__video"
            autoplay
            muted
            loop
            playsinline
            aria-hidden="true"
          >
            <source src={src} type="video/mp4" />
          </video>
        </div>
      ))}

      <div class="scroll-scene__video-wrap" data-scene-video-wrap>
        <video
          class="scroll-scene__video"
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
        >
          <source src={VIDEO_SRC} type="video/mp4" />
        </video>
        <div class="scroll-scene__video-overlay" aria-hidden="true"></div>
      </div>

    </div>

    <!-- Texto fijo en el stage, independiente del grid que escala debajo -->
    <div class="scroll-scene__text" data-scene-text aria-hidden="true">
      <p class="scroll-scene__headline">
        {headlineWords.map((word, i) => (
          <span class="scroll-scene__word" data-scene-headline-word>
            {i < headlineWords.length - 1 ? `${word}\u00a0` : word}
          </span>
        ))}
      </p>
      <p class="scroll-scene__subline">
        {sublineWords.map((word, i) => (
          <span class="scroll-scene__word" data-scene-subline-word>
            {i < sublineWords.length - 1 ? `${word}\u00a0` : word}
          </span>
        ))}
      </p>
    </div>

    <p class="sr-only">{PHRASE}</p>
  </div>
</section>

<style>
  /* ── Sección: altura total para las 4 fases ── */
  .scroll-scene {
    position: relative;
    height: 250vh;
  }

  @media (min-width: 768px) {
    .scroll-scene {
      height: 270vh;
    }
  }

  /* ── Stage: fijo en viewport; recorta el grid cuando está ampliado ── */
  .scroll-scene__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
  }

  /* ── Grid: misma estructura 4 cols × 3 filas en todos los breakpoints ── */
  .scroll-scene__grid {
    position: absolute;
    inset: 8px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    grid-template-rows: 1fr 2.5fr 1fr;
    gap: 8px;
    transform-origin: center center;
    will-change: transform;
  }

  /* Mobile: fila central se adapta al aspect-ratio 9:16 del video */
  @media (max-width: 767px) {
    .scroll-scene__grid {
      grid-template-rows: 1fr auto 1fr;
    }
    .scroll-scene__video-wrap {
      aspect-ratio: 9 / 16;
    }
  }

  /* ── Tarjetas circundantes ── */
  .scroll-scene__surround-card {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--palette-ink);
  }

  .surround--tl { grid-column: 1 / 3; grid-row: 1; }
  .surround--tr { grid-column: 3 / 5; grid-row: 1; }
  .surround--l  { grid-column: 1;     grid-row: 2; }
  .surround--r  { grid-column: 4;     grid-row: 2; }
  .surround--bl { grid-column: 1 / 3; grid-row: 3; }
  .surround--br { grid-column: 3 / 5; grid-row: 3; }

  .scroll-scene__surround-card .scroll-scene__video {
    opacity: 0.2;
  }

  /* ── Video wrap: col central (2-3) en todos los breakpoints ── */
  .scroll-scene__video-wrap {
    position: relative;
    grid-column: 2 / 4;
    grid-row: 2;
    opacity: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    will-change: opacity;
  }

  .scroll-scene__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: inherit;
  }

  .scroll-scene__video-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(15, 24, 34, 0.52);
    pointer-events: none;
    border-radius: inherit;
  }

  /* ── Texto: centrado sobre el stage, independiente del grid ── */
  .scroll-scene__text {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: min(22rem, 86vw);
    padding-inline: 1.25rem;
    box-sizing: border-box;
    text-align: center;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .scroll-scene__headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #f2f4f6;
  }

  .scroll-scene__subline {
    font-family: var(--font-sans);
    font-size: clamp(0.9375rem, 2.2vw, 1.125rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0em;
    color: rgba(242, 244, 246, 0.85);
    max-width: 28rem;
  }

  @media (min-width: 768px) {
    .scroll-scene__text {
      gap: 1rem;
      max-width: 56rem;
      padding-inline: 1.5rem;
    }

    .scroll-scene__headline {
      font-size: clamp(2.5rem, 3.8vw, 3.5rem);
    }

    .scroll-scene__subline {
      font-size: clamp(1rem, 1.4vw, 1.25rem);
      max-width: 32rem;
    }
  }

  .scroll-scene__word {
    display: inline;
    will-change: opacity;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .scroll-scene {
      height: auto;
    }

    .scroll-scene__stage {
      position: relative;
      min-height: 36vh;
    }

    .scroll-scene__video-wrap {
      opacity: 0;
    }

    .scroll-scene__word {
      opacity: 1 !important;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let scrollSceneMedia: gsap.MatchMedia | null = null;

  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  interface SceneTimelineConfig {
    initialScale: number;
    finalScale: number;
    scaleStart: number;
    scaleDuration: number;
    textFadeStart: number;
    textFadeDuration: number;
    scrollEnd: string;
  }

  /**
   * Construye el timeline scrubbed.
   * scaleTarget = el elemento al que GSAP aplica el scale (siempre el grid completo).
   */
  function buildScrollTimeline(
    section: HTMLElement,
    scaleTarget: HTMLElement,
    videoWrap: HTMLElement,
    textEl: HTMLElement,
    headlineWords: HTMLElement[],
    sublineWords: HTMLElement[],
    surroundCards: HTMLElement[],
    config: SceneTimelineConfig
  ): void {
    gsap.set([...headlineWords, ...sublineWords], { opacity: 0 });
    gsap.set(videoWrap, { opacity: 0 });
    gsap.set(textEl, { opacity: 1 });
    gsap.set(scaleTarget, { scale: config.initialScale, transformOrigin: "center center" });
    if (surroundCards.length) gsap.set(surroundCards, { opacity: 0 });

    const tl = gsap.timeline();

    // Fase 1: video fade-in (grid ampliado, tarjetas fuera del viewport)
    tl.to(videoWrap, { opacity: 1, duration: 2.4, ease: "power1.inOut" }, 0);

    // Fase 2: texto palabra a palabra
    tl.to(
      headlineWords,
      { opacity: 1, stagger: { amount: 1.2 }, duration: 0.5, ease: "none" },
      0.35
    );
    tl.to(
      sublineWords,
      { opacity: 1, stagger: { amount: 1.4 }, duration: 0.5, ease: "none" },
      1.4
    );

    // Fase 3: zoom-out → grid escala, tarjetas circundantes entran al frame
    tl.to(
      scaleTarget,
      { scale: config.finalScale, duration: config.scaleDuration, ease: "power2.inOut" },
      config.scaleStart
    );

    // Tarjetas circundantes: fade-in simultáneo al poco de arrancar el zoom-out
    if (surroundCards.length) {
      tl.to(
        surroundCards,
        { opacity: 1, duration: config.scaleDuration * 0.7, ease: "power1.inOut" },
        config.scaleStart + 0.55
      );
    }

    // Fase 4: texto se desvanece
    tl.to(
      textEl,
      { opacity: 0, duration: config.textFadeDuration, ease: "power1.in" },
      config.textFadeStart
    );

    ScrollTrigger.create({
      id: "scroll-scene",
      trigger: section,
      start: "top bottom",
      end: config.scrollEnd,
      scrub: 1,
      animation: tl,
    });
  }

  function initScrollScene(): void {
    const section = document.querySelector<HTMLElement>("[data-scroll-scene]");
    if (!section) return;

    const headlineWords = Array.from(
      section.querySelectorAll<HTMLElement>("[data-scene-headline-word]")
    );
    const sublineWords = Array.from(
      section.querySelectorAll<HTMLElement>("[data-scene-subline-word]")
    );
    const videoWrap = section.querySelector<HTMLElement>("[data-scene-video-wrap]");
    const textEl    = section.querySelector<HTMLElement>("[data-scene-text]");
    const gridEl    = section.querySelector<HTMLElement>("[data-scene-grid]");
    const stage     = section.querySelector<HTMLElement>("[data-scene-stage]");

    if (!headlineWords.length || !sublineWords.length || !videoWrap || !textEl || !gridEl || !stage) return;

    scrollSceneMedia?.revert();
    scrollSceneMedia = gsap.matchMedia();

    ScrollTrigger.getAll()
      .filter((t) => t.vars["id"] === "scroll-scene")
      .forEach((t) => t.kill());

    if (prefersReducedMotion()) {
      gsap.set([...headlineWords, ...sublineWords], { opacity: 1 });
      gsap.set(section.querySelectorAll<HTMLElement>("[data-scene-surround]"), { opacity: 1 });
      return;
    }

    const surroundCards = Array.from(
      section.querySelectorAll<HTMLElement>("[data-scene-surround]")
    );

    // ── Mobile: misma cuadrícula 4×3, proporciones portrait por el viewport ──
    scrollSceneMedia.add("(max-width: 767px)", () => {
      const stageW = stage.offsetWidth;
      const stageH = stage.offsetHeight;
      const gridW2 = stageW - 16;
      const gridH2 = stageH - 16;

      // Video central: 2 columnas de ancho, aspect-ratio 9:16 (mismo que CSS)
      const colW2   = (gridW2 - 24) / 4;
      const videoW2 = colW2 * 2 + 8;
      const videoH2 = videoW2 * (16 / 9); // 9:16 → height = width × 16/9

      const START_COVERAGE = 0.92; // inicio: video ~92% del ancho del viewport
      const END_COVERAGE   = 0.82; // final: video ~82% — menos zoom-out

      const initialScale = Math.min(
        (stageW * START_COVERAGE) / videoW2,
        stageH / videoH2
      );
      const finalScale = (stageW * END_COVERAGE) / videoW2;

      buildScrollTimeline(
        section, gridEl, videoWrap, textEl, headlineWords, sublineWords, surroundCards,
        {
          initialScale,
          finalScale,
          scaleStart: 2.7,
          scaleDuration: 1.8,
          textFadeStart: 3.9,
          textFadeDuration: 0.55,
          scrollEnd: "bottom 50%",
        }
      );
    });

    // ── Desktop: 4 cols × 3 filas ─────────────────────────────────────────────
    scrollSceneMedia.add("(min-width: 768px)", () => {
      const stageW = stage.offsetWidth;
      const stageH = stage.offsetHeight;
      const gridW  = stageW - 16;
      const gridH  = stageH - 16;

      // Video: cols 2-3 de 4 iguales con 3 gaps de 8px
      const colW   = (gridW - 24) / 4;
      const videoW = colW * 2 + 8;

      // Video: row 2 (2.5fr de 4.5fr total) con 2 gaps de 8px
      const rowUnit = (gridH - 16) / 4.5;
      const videoH  = rowUnit * 2.5;

      // Scale mínimo: el video CABE en el viewport (ambas dimensiones) al 88 %
      const VIDEO_VIEWPORT_COVERAGE = 0.88;
      const fitScale     = Math.min(stageW / videoW, stageH / videoH);
      const initialScale = fitScale * VIDEO_VIEWPORT_COVERAGE;

      buildScrollTimeline(
        section, gridEl, videoWrap, textEl, headlineWords, sublineWords, surroundCards,
        {
          initialScale,
          finalScale: 1.0,
          scaleStart: 3.1,
          scaleDuration: 2.2,
          textFadeStart: 4.8,
          textFadeDuration: 0.65,
          scrollEnd: "bottom 62%",
        }
      );
    });
  }

  initScrollScene();
  document.addEventListener("astro:page-load", () => {
    initScrollScene();
    ScrollTrigger.refresh();
  });
</script>
