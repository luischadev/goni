---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import { cms } from "../../lib/cms";
import { getPracticeAreaHeroImage } from "../../lib/practice-area-hero-images";

const areas = await cms.getPracticeAreas();
---

<BaseLayout
  title="Áreas de práctica"
  description="Las áreas en las que el estudio concentra su práctica: seguros, recuperos, responsabilidad civil, derecho marítimo y transporte, corporativo y litigios."
  headerVariant="transparent"
>
  <section class="bg-surface-inverse text-fg-on-inverse">
    <div class="container-x pt-28 md:pt-36 pb-16 md:pb-24">
      <div class="grid grid-cols-1 md:grid-cols-12 md:gap-y-20">
        <h1 class="font-display text-5xl md:col-span-10 md:text-7xl lg:text-[88px] leading-[0.95] tracking-[-0.035em] text-fg-on-inverse reveal">
          Profundidad técnica en los frentes que definen su industria.
        </h1>
        <p class="mt-5 text-xl md:mt-0 md:col-span-8 md:col-start-5 md:text-xl leading-relaxed text-fg-on-inverse/75 reveal">
          Hemos construido nuestra práctica alrededor de los riesgos más complejos
          del mercado asegurador, logístico y marítimo. Cada área del estudio combina
          conocimiento académico de alto nivel con experiencia forense intensiva.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-surface-soft">
    <div class="container-x py-16 md:py-32">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-5 lg:gap-6">
        {areas.map((area) => {
          const heroImage = getPracticeAreaHeroImage(area.slug);

          return (
            <a
              href={`/areas-de-practica/${area.slug}`}
              class="group reveal relative block min-h-[28rem] overflow-hidden bg-surface-inverse shadow-[0_24px_80px_rgba(15,24,34,0.08)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-line-strong md:min-h-[32rem]"
            >
              <div class="pointer-events-none absolute inset-0" aria-hidden="true">
                <img
                  src={heroImage.src}
                  alt=""
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-inverse/95 via-surface-inverse/62 to-surface-inverse/10"></div>
              </div>

              <div class="relative z-10 flex min-h-[28rem] flex-col justify-end p-6 text-fg-on-inverse sm:p-8 md:min-h-[32rem] md:p-10 lg:p-12">
                <h2 class="link-underline [text-decoration-line:underline] md:[text-decoration-line:none] md:group-hover:[text-decoration-line:underline] font-display text-3xl sm:text-4xl md:text-4xl lg:text-5xl leading-[1.04] tracking-[-0.03em] text-fg-on-inverse transition-colors group-hover:text-fg-on-inverse-interaction">
                  {area.title}
                </h2>

                <p class="mt-4 max-w-xl text-sm sm:text-base md:text-base lg:text-lg text-fg-on-inverse/85 leading-relaxed md:leading-snug">
                  {area.shortDescription}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <CTASection
    title="¿Necesita evaluar un asunto con nuestro equipo?"
    description="Coordinamos una conversación inicial para entender el contexto, identificar los riesgos relevantes y orientar la mejor forma de abordar su caso."
    buttonLabel="Contáctanos"
  />
</BaseLayout>
