---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import Button from "../../components/ui/Button.astro";
import PracticeAreaFeatureItem from "../../components/practice/PracticeAreaFeatureItem.astro";
import { cms } from "../../lib/cms";
import { getPracticeAreaHeroImage } from "../../lib/practice-area-hero-images";
import type { PracticeArea } from "../../lib/types";

export async function getStaticPaths() {
  const areas = await cms.getPracticeAreas();
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: PracticeArea;
}

const { area } = Astro.props;

const allAreas = await cms.getPracticeAreas();
const otherAreas = allAreas.filter((a) => a.slug !== area.slug);
const heroImage = getPracticeAreaHeroImage(area.slug);
const heroHighlights = area.highlights;
const heroHighlightColumns =
  heroHighlights.length === 2 ? "md:grid-cols-2" : "md:grid-cols-4";
const featureSection = {
  eyebrow: "Cómo trabajamos",
  title: area.featuresTitle,
};
---

<BaseLayout
  title={area.title}
  description={area.shortDescription}
  headerVariant="solid"
>
  <section
    class="scroll-background-section scroll-background--surface-soft text-fg"
    data-scroll-background
    data-scroll-background-start="bottom 90%"
    data-scroll-background-end="bottom top"
  >
    <div class="container-x pt-14 md:pt-28 pb-0">
      <nav
        class="flex items-center reveal md:hidden"
        aria-label="Página padre"
      >
        <Button href="/areas-de-practica" variant="ghost" showArrow={false}>
          <span aria-hidden="true">←</span>
          Áreas de práctica
        </Button>
      </nav>

      <nav
        class="text-sm text-fg-muted hidden md:flex items-center gap-2 reveal"
        aria-label="Breadcrumb"
      >
        <a href="/" class="hover:text-fg transition-colors">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/areas-de-practica" class="hover:text-fg transition-colors">
          Áreas de práctica
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-fg">{area.title}</span>
      </nav>

      <div class="mt-10 md:mt-20">
        <div class="max-w-5xl">
          <h1 class="font-display text-4xl md:text-6xl leading-[1.0] tracking-[-0.02em] reveal reveal-from-top">
            {area.title}
          </h1>
          <p class="mt-5 md:mt-10 max-w-4xl text-lg md:text-xl leading-relaxed text-fg-soft reveal reveal-fade">
            {area.intro}
          </p>
        </div>

        <figure class="relative left-1/2 mt-16 w-screen -translate-x-1/2 bg-surface-inverse md:left-auto md:w-auto md:translate-x-0">
          <div class="relative aspect-[3/4] overflow-hidden md:aspect-video md:rounded-media">
            <img
              src={heroImage.src}
              alt={heroImage.alt}
              width="1800"
              height="1013"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-surface-inverse via-surface-inverse/62 to-surface-inverse/10"
              aria-hidden="true"
            ></div>
          </div>

          <figcaption
            class="relative -mt-80 px-5 pb-16 pt-28 text-fg-on-inverse md:-mt-64 md:px-8 md:pb-12 md:pt-28 lg:px-10 lg:pb-14"
            style="background: linear-gradient(to bottom, transparent 0, transparent 4rem, color-mix(in srgb, var(--color-surface-inverse) 72%, transparent) 9rem, var(--color-surface-inverse) 13rem, var(--color-surface-inverse) 100%);"
          >
            <div class:list={["grid grid-cols-2 gap-x-5 gap-y-8 md:gap-8", heroHighlightColumns]}>
              {heroHighlights.map((highlight) => (
                <div>
                  <span class="material-symbols-sharp text-3xl md:text-5xl text-fg-on-inverse/85 leading-none reveal reveal-from-top" aria-hidden="true">
                    {highlight.icon}
                  </span>
                  <h3 class="font-display text-xl md:text-2xl mt-4 md:mt-6 leading-[1.15] text-fg-on-inverse reveal reveal-from-top">
                    {highlight.title}
                  </h3>
                  <p class="mt-3 md:mt-4 text-xs md:text-sm leading-relaxed text-fg-on-inverse/75 reveal reveal-fade">
                    {highlight.description}
                  </p>
                </div>
              ))}
            </div>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {area.features && area.features.length > 0 && (
    <section class="border-b border-line bg-surface-soft">
      <div class="container-x py-20 md:py-28">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
          <div class="md:col-span-4">
            <div class="md:sticky md:top-32 md:pb-8">
              <p class="eyebrow reveal">{featureSection.eyebrow}</p>
              <h2 class="font-display text-3xl md:text-5xl mt-6 leading-[1.1] reveal">
                {featureSection.title}
              </h2>
            </div>
          </div>

          <div class="md:col-span-7 md:col-start-6 reveal">
            <div class="divide-y divide-line border-t border-line">
              {area.features.map((feature) => (
                <PracticeAreaFeatureItem feature={feature} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <CTASection
    title={`Conversemos sobre cómo ${area.title.toLowerCase()} aplica a su operación.`}
    description={`Coordinamos una reunión inicial para evaluar el contexto de su empresa, los riesgos críticos y la mejor forma de abordar ${area.title.toLowerCase()} con una estrategia clara.`}
    buttonLabel="Contáctanos"
  />

  <section class="border-t border-line bg-surface-soft">
    <div class="container-x py-20 md:py-28">
      <div class="flex items-end justify-between mb-12">
        <p class="eyebrow">Otras áreas del estudio</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-20">
        {otherAreas.map((other) => (
          <a
            href={`/areas-de-practica/${other.slug}`}
            class="group block border-t border-line py-8 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-line-strong"
          >
            <h3 class="link-underline [text-decoration-line:underline] font-display text-2xl md:text-4xl leading-[1.05] text-fg transition-colors group-hover:text-fg-accent">
              {other.title}
            </h3>
            <p class="mt-4 max-w-xl text-sm md:text-base leading-relaxed text-fg-muted">
              {other.shortDescription}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
