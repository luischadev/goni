---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import TextLink from "../components/ui/TextLink.astro";
import { cms } from "../lib/cms";

const settings = await cms.getSiteSettings();
const areas = await cms.getPracticeAreas();

const fieldGroupClass = "space-y-2";
const labelClass = "block text-sm font-medium leading-none text-fg-muted";
const helperClass = "text-xs leading-relaxed text-fg-muted";
const fieldClass =
  "contact-field-input w-full min-h-12 rounded-card bg-surface-soft border border-transparent border-b-line px-4 py-3 text-base leading-normal text-fg outline-none transition-colors duration-[160ms] placeholder:text-fg-subtle hover:border-b-line-strong focus:[border-color:var(--color-fg-accent)] focus:hover:[border-color:var(--color-fg-accent)] disabled:cursor-not-allowed disabled:bg-surface-soft/60 disabled:text-fg-subtle";
const textareaClass = `${fieldClass} min-h-36 resize-none overflow-hidden`;
const contactFieldClass = `${fieldGroupClass} contact-field`;
const selectClass = `${fieldClass} appearance-none pr-12`;
const contactDetailLinkClass =
  "mt-4 inline-block font-display text-2xl md:text-3xl text-fg hover:text-fg-accent transition-colors link-underline [text-decoration-line:underline] md:[text-decoration-line:none] md:hover:[text-decoration-line:underline]";
const contactFormUrl = import.meta.env.PUBLIC_CONTACT_FORM_URL ?? "";
---

<BaseLayout
  title="Contacto"
  description="Contacte a Goñi & Cía. Abogados. Coordinamos una reunión inicial para evaluar su caso o programa de seguros."
>
  <section class="container-x pt-20 md:pt-32 pb-12 md:pb-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
      <div class="md:col-span-8">
        <p class="eyebrow reveal">Contacto</p>
        <h1 class="font-display text-4xl md:text-6xl leading-[1.05] mt-8 reveal">
          Conversemos sobre la operación legal de su empresa.
        </h1>
        <p class="mt-10 max-w-2xl text-base md:text-lg text-fg-muted leading-relaxed reveal">
          Coordinamos una reunión inicial, sin compromiso, para entender el contexto
          de su empresa o aseguradora, los riesgos críticos y la mejor forma de
          articular una asesoría que aporte valor desde el primer día.
        </p>
      </div>
    </div>
  </section>

  <section id="consulta" class="border-y border-line scroll-mt-24 md:scroll-mt-28">
    <div class="container-x py-20 md:py-28">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
        <div class="md:col-span-5">
          <p class="eyebrow reveal">Datos de contacto</p>

          <div class="mt-10 space-y-10 reveal">
            <div>
              <p class="text-xs uppercase tracking-[var(--tracking-eyebrow)] text-fg-subtle">
                Oficina
              </p>
              <address class="not-italic mt-4 text-base md:text-lg text-fg-soft leading-relaxed">
                {settings.address.street}<br />
                {settings.address.city}<br />
                {settings.address.region}, {settings.address.country}
              </address>
              <div class="mt-5">
                <TextLink
                  href={settings.address.mapsUrl}
                  size="md"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Ver en Google Maps
                </TextLink>
              </div>
            </div>

            <div>
              <p class="text-xs uppercase tracking-[var(--tracking-eyebrow)] text-fg-subtle">
                Email
              </p>
              <a
                href={`mailto:${settings.email}`}
                class={contactDetailLinkClass}
              >
                {settings.email}
              </a>
            </div>

            <div>
              <p class="text-xs uppercase tracking-[var(--tracking-eyebrow)] text-fg-subtle">
                Teléfono
              </p>
              <a
                href={`tel:${settings.phone.replace(/\s+/g, "")}`}
                class={contactDetailLinkClass}
              >
                {settings.phone}
              </a>
            </div>

            <div>
              <p class="text-xs uppercase tracking-[var(--tracking-eyebrow)] text-fg-subtle">
                Horario de atención
              </p>
              <p class="mt-4 text-base text-fg-soft leading-relaxed">
                Lunes a viernes<br />
                09:00 – 18:30 hrs.
              </p>
            </div>
          </div>
        </div>

        <div class="md:col-span-6 md:col-start-7">
          <p class="eyebrow reveal">Formulario de consulta</p>

          <form
            class="contact-form mt-10 space-y-7 reveal"
            method="POST"
            action="#"
            name="contact"
            data-contact-form
            data-contact-endpoint={contactFormUrl}
            novalidate
          >
            <div class="sr-only" aria-hidden="true">
              <label for="website">Sitio web</label>
              <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class={contactFieldClass} data-contact-field>
                <label for="name" class={labelClass}>
                  Nombre completo
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class={fieldClass}
                  data-contact-input
                  placeholder="Nombre y apellido"
                  aria-describedby="name-helper name-error-helper"
                />
                <p id="name-helper" class={`${helperClass} contact-helper-default`}>
                  Ingrese nombre y apellido.
                </p>
                <p id="name-error-helper" class={`${helperClass} contact-helper-invalid`}>
                  Ingrese su nombre completo.
                </p>
              </div>
              <div class={fieldGroupClass}>
                <label for="company" class={labelClass}>
                  Empresa <span class="text-fg-subtle">(opcional)</span>
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  class={fieldClass}
                  placeholder="Empresa u organización"
                  aria-describedby="company-helper"
                />
                <p id="company-helper" class={helperClass}>
                  Indique su empresa u organización si corresponde.
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class={contactFieldClass} data-contact-field>
                <label for="email" class={labelClass}>
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class={fieldClass}
                  data-contact-input
                  placeholder="nombre@empresa.cl"
                  aria-describedby="email-helper email-format-helper"
                />
                <p id="email-helper" class={`${helperClass} contact-helper-default`}>
                  Usaremos este correo para responder su consulta.
                </p>
                <p id="email-format-helper" class={`${helperClass} contact-helper-invalid`}>
                  Ingrese un email válido, por ejemplo nombre@empresa.cl.
                </p>
              </div>
              <div class={fieldGroupClass}>
                <label for="phone" class={labelClass}>
                  Teléfono <span class="text-fg-subtle">(opcional)</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class={fieldClass}
                  placeholder="+56 9 0000 0000"
                  aria-describedby="phone-helper"
                />
                <p id="phone-helper" class={helperClass}>
                  Incluya código de país si corresponde.
                </p>
              </div>
            </div>

            <div class={fieldGroupClass}>
              <label for="area" class={labelClass}>
                Área de interés <span class="text-fg-subtle">(opcional)</span>
              </label>
              <div class="relative">
                <select
                  id="area"
                  name="area"
                  class={selectClass}
                  aria-describedby="area-helper"
                >
                  <option value="">Seleccione un área</option>
                  {areas.map((area) => (
                    <option value={area.slug}>{area.title}</option>
                  ))}
                  <option value="otro">Otra consulta</option>
                </select>
                <span
                  class="material-symbols-sharp pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-xl leading-none text-fg-muted"
                  aria-hidden="true"
                >
                  expand_more
                </span>
              </div>
              <p id="area-helper" class={helperClass}>
                Seleccione el frente principal de su consulta.
              </p>
            </div>

            <div class={contactFieldClass} data-contact-field>
              <label for="message" class={labelClass}>
                Cuéntenos brevemente su caso
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class={textareaClass}
                data-contact-input
                placeholder="¿En qué podemos ayudarle?"
                aria-describedby="message-error-helper"
              ></textarea>
              <p id="message-error-helper" class={`${helperClass} contact-helper-invalid`}>
                Cuéntenos brevemente su caso para poder responderle.
              </p>
            </div>

            <Button type="submit" size="lg" data-contact-submit>Enviar consulta</Button>
            <p
              class="contact-form-status hidden text-sm leading-relaxed"
              data-contact-status
              role="status"
              aria-live="polite"
            ></p>
          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  .contact-form {
    --contact-error-color: #7a1f2b;
  }

  .contact-field .contact-helper-invalid {
    color: var(--contact-error-color);
    display: none;
  }

  .contact-field.field-error .contact-field-input {
    border-color: var(--contact-error-color);
  }

  .contact-field.field-error .contact-field-input:hover,
  .contact-field.field-error .contact-field-input:focus,
  .contact-field.field-error .contact-field-input:focus:hover {
    border-color: var(--contact-error-color);
  }

  .contact-field.field-error .contact-helper-default {
    display: none;
  }

  .contact-field.field-error .contact-helper-invalid {
    display: block;
  }

  .contact-form-status.is-success {
    color: var(--color-fg-muted);
  }

  .contact-form-status.is-error {
    color: var(--contact-error-color);
  }
</style>

<script define:vars={{ contactFormUrl }}>
  function initContactForm() {
    const form = document.querySelector("[data-contact-form]");
    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.initialized === "true") return;
    form.dataset.initialized = "true";

    const fields = form.querySelectorAll("[data-contact-input][required]");
    const statusEl = form.querySelector("[data-contact-status]");
    const submitButton = form.querySelector("[data-contact-submit]");
    const endpoint = form.dataset.contactEndpoint || contactFormUrl;

    const setStatus = (type, message) => {
      if (!(statusEl instanceof HTMLElement)) return;

      statusEl.textContent = message;
      statusEl.classList.remove("hidden", "is-success", "is-error");
      statusEl.classList.add(type === "success" ? "is-success" : "is-error");
    };

    const clearStatus = () => {
      if (!(statusEl instanceof HTMLElement)) return;

      statusEl.textContent = "";
      statusEl.classList.add("hidden");
      statusEl.classList.remove("is-success", "is-error");
    };

    const resetFormState = () => {
      form.querySelectorAll("[data-contact-field]").forEach((group) => {
        group.classList.remove("field-error");
      });

      form.querySelectorAll("[data-contact-input]").forEach((field) => {
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
          field.dataset.touched = "false";
          field.setAttribute("aria-invalid", "false");
        }
      });

      const messageField = form.querySelector("#message");
      if (messageField instanceof HTMLTextAreaElement) {
        messageField.style.height = "auto";
      }
    };

    const getFieldValue = (name) => {
      const field = form.elements.namedItem(name);
      if (field instanceof RadioNodeList) {
        return field.value;
      }
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
        return field.value;
      }
      return "";
    };

    const resizeTextarea = (field) => {
      if (!(field instanceof HTMLTextAreaElement)) return;

      field.style.height = "auto";
      field.style.height = `${field.scrollHeight}px`;
    };

    const validateField = (field, showAll = false) => {
      if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) {
        return false;
      }

      const group = field.closest("[data-contact-field]");
      if (!(group instanceof HTMLElement)) return false;

      const hasValue = field.value.trim() !== "";
      const isTouched = field.dataset.touched === "true";
      const isInvalid = !field.checkValidity();
      const showError =
        showAll ? isInvalid : isInvalid && (hasValue || (isTouched && field.required));

      group.classList.toggle("field-error", showError);
      field.setAttribute("aria-invalid", showError ? "true" : "false");

      return showError;
    };

    fields.forEach((field) => {
      resizeTextarea(field);

      field.addEventListener("input", () => {
        if (field.value.trim() !== "") {
          field.dataset.touched = "true";
        }
        resizeTextarea(field);
        validateField(field);
      });

      field.addEventListener("blur", () => {
        field.dataset.touched = "true";
        validateField(field);
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearStatus();

      let hasError = false;

      fields.forEach((field) => {
        field.dataset.touched = "true";
        if (validateField(field, true)) {
          hasError = true;
        }
      });

      if (hasError) {
        const firstInvalid = form.querySelector(
          "[data-contact-field].field-error [data-contact-input]"
        );
        if (firstInvalid instanceof HTMLElement) {
          firstInvalid.focus();
        }
        return;
      }

      if (!endpoint) {
        setStatus(
          "error",
          "El formulario no está configurado. Escríbanos directamente a abogados@goniabogados.cl."
        );
        return;
      }

      const payload = {
        name: getFieldValue("name").trim(),
        company: getFieldValue("company").trim(),
        email: getFieldValue("email").trim(),
        phone: getFieldValue("phone").trim(),
        area: getFieldValue("area").trim(),
        message: getFieldValue("message").trim(),
        website: getFieldValue("website").trim(),
      };

      const defaultSubmitLabel =
        submitButton instanceof HTMLButtonElement ? submitButton.textContent : "Enviar consulta";

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = "Enviando...";
      }

      try {
        await fetch(endpoint, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        form.reset();
        resetFormState();
        setStatus(
          "success",
          "Gracias. Recibimos su consulta y le responderemos a la brevedad."
        );
      } catch {
        setStatus(
          "error",
          "No pudimos enviar su consulta. Inténtelo nuevamente o escríbanos directamente."
        );
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = defaultSubmitLabel;
        }
      }
    });
  }

  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>
