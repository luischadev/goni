---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import PageHero from "../components/PageHero.astro";
import TrustIndicatorsSection from "../components/home/TrustIndicatorsSection.astro";
import TrustIndicatorsSectionV2 from "../components/home/TrustIndicatorsSectionV2.astro";
import PracticeAreaStackSection from "../components/practice/PracticeAreaStackSection.astro";
import TestimonialHorizontalSection from "../components/testimonials/TestimonialHorizontalSection.astro";
import PublicationItem from "../components/publications/PublicationItem.astro";
import Button from "../components/ui/Button.astro";
import TextLink from "../components/ui/TextLink.astro";
import { cms } from "../lib/cms";

const [settings, hero, indicators, areas, testimonials, publications] =
  await Promise.all([
    cms.getSiteSettings(),
    cms.getHomeHero(),
    cms.getIndicators(),
    cms.getPracticeAreas(),
    cms.getTestimonials(),
    cms.getPublications(),
  ]);

const featuredPublications = publications.slice(0, 3);
---

<BaseLayout
  description={settings.tagline}
  headerVariant="transparent"
>
  <PageHero
    videoSrc={hero.backgroundVideo?.url}
    imgSrc={hero.backgroundImage.url}
    imgAlt={hero.backgroundImage.alt}
    overlayOpacity={hero.overlayOpacity}
    minHeight={hero.minHeight}
  >
    <div class="grid grid-cols-1 md:grid-cols-12">
      <div class="md:col-span-10">
        <h1
          class="font-display text-4xl sm:text-5xl md:text-6xl leading-[1.05] tracking-[-0.01em] text-fg-on-inverse"
          data-home-hero-item="title"
        >
          {hero.title}
        </h1>
        <p
          class="mt-6 md:mt-8 max-w-xl text-lg md:text-xl text-fg-on-inverse/75 leading-relaxed"
          data-home-hero-item="subtitle"
        >
          {hero.subtitle}
        </p>
        <div
          class="mt-8 md:mt-10 flex flex-col sm:flex-row gap-6 sm:items-center"
          data-home-hero-item="actions"
        >
          <Button href="/contacto#consulta" tone="inverse" class="md:min-w-[240px]">Contactar</Button>
          <TextLink href="/areas-de-practica" variant="inverse" size="lg" class="self-start sm:self-auto">
            Áreas de práctica
          </TextLink>
        </div>
      </div>
    </div>
  </PageHero>

  {/* Indicadores — versión anterior (conservada) */}
  {/*
  <TrustIndicatorsSection indicators={indicators} />
  */}

  <section aria-labelledby="home-intro" class="container-x py-16 md:py-32 border-b border-line">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-3">
        <p class="eyebrow reveal">Una mirada experta</p>
      </div>

      <div class="md:col-span-8 md:col-start-5">
        <h2
          id="home-intro"
          class="font-display text-3xl md:text-5xl leading-[1.22] md:leading-[1.14] text-fg-muted"
          data-scroll-text-reveal
        >
          Goñi & Cia. es un estudio jurídico formado con una extensa experiencia
          en el mercado nacional e internacional prestando servicios legales
          integrales y especializados en materias civiles y comerciales,
          fundamentalmente en asuntos relacionados con seguros y reaseguros.
        </h2>
        <div class="mt-8 md:mt-10 reveal">
          <TextLink href="/nosotros" size="xl">Más sobre nosotros</TextLink>
        </div>
      </div>
    </div>
  </section>

  <TrustIndicatorsSectionV2 />

  <PracticeAreaStackSection areas={areas} />

  {/* Secciones ocultas temporalmente: testimonios y publicaciones */}
  {/*
  <TestimonialHorizontalSection testimonials={testimonials} />

  <section aria-labelledby="publications" class="bg-surface-soft py-16 md:py-32 border-y border-line">
    <div class="container-x">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10 items-end mb-10 md:mb-20">
        <div class="md:col-span-7">
          <p class="eyebrow reveal">Publicaciones</p>
          <h2 id="publications" class="font-display text-3xl md:text-5xl mt-6 leading-[1.05] reveal">
            Análisis técnicos que orientan decisiones de negocio.
          </h2>
        </div>
        <div class="md:col-span-4 md:col-start-9 md:text-right reveal">
          <TextLink href="/publicaciones" size="xl">Ver todas las publicaciones</TextLink>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-14">
        {featuredPublications.map((publication) => (
          <PublicationItem publication={publication} variant="card" showCta={false} />
        ))}
      </div>
    </div>
  </section>
  */}

  <CTASection
    title="¿Tiene un caso o un programa de seguros que evaluar con nosotros?"
    description="Coordinamos una reunión inicial para entender el contexto de su empresa o aseguradora, los riesgos críticos y la mejor forma de articular una asesoría que aporte valor desde el primer día."
    buttonLabel="Contáctanos"
  />
</BaseLayout>

