---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CTASection from "../../../components/CTASection.astro";
import Button from "../../../components/ui/Button.astro";
import PracticeAreaFeatureItem from "../../../components/practice/PracticeAreaFeatureItem.astro";
import { cms } from "../../../lib/cms";
import { getPracticeAreaHeroImage } from "../../../lib/content";
import { LANGS, DEFAULT_LANG, getLang, localizePath, ui } from "../../../lib/i18n";

export async function getStaticPaths() {
  const paths = await Promise.all(
    LANGS.map(async (lang) => {
      const areas = await cms.getPracticeAreas(lang);
      return areas.map((area) => ({
        params: {
          lang: lang === DEFAULT_LANG ? undefined : lang,
          slug: area.slug,
        },
        props: { area },
      }));
    })
  );

  return paths.flat();
}

const { area } = Astro.props;

const lang = getLang(Astro.url);
const t = ui[lang].practiceDetail;

const allAreas = await cms.getPracticeAreas(lang);
const otherAreas = allAreas.filter((a) => a.slug !== area.slug);
const heroImage = getPracticeAreaHeroImage(lang, area.slug);
const areasHref = localizePath("/areas-de-practica", lang);
---

<BaseLayout
  title={area.title}
  description={area.shortDescription}
  headerVariant="solid"
>
  <section
    class="scroll-background-section scroll-background--surface-soft text-fg"
    data-scroll-background
    data-scroll-background-start="bottom 90%"
    data-scroll-background-end="bottom top"
  >
    <figure class="relative w-full bg-surface-inverse">
      <div class="relative min-h-[72vh] overflow-hidden md:min-h-[78vh] media-skeleton media-skeleton--inverse">
        <Image
          src={heroImage.src}
          alt={heroImage.alt}
          width={2000}
          height={1125}
          format="webp"
          fetchpriority="high"
          loading="eager"
          data-skeleton
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0 z-[2] bg-gradient-to-t from-surface-inverse via-surface-inverse/55 to-surface-inverse/10"
          aria-hidden="true"
        ></div>

        <div class="absolute inset-x-0 top-0 z-10">
          <div class="container-x pt-12">
            <nav
              class="flex items-center reveal md:hidden"
              aria-label={ui[lang].a11y.parentPage}
            >
              <Button href={areasHref} variant="ghost" tone="inverse" showArrow={false}>
                <span aria-hidden="true">←</span>
                {t.backToAreas}
              </Button>
            </nav>

            <nav
              class="hidden items-center gap-2 text-sm text-fg-on-inverse/70 md:flex reveal"
              aria-label={ui[lang].a11y.breadcrumb}
            >
              <a href={localizePath("/", lang)} class="transition-colors hover:text-fg-on-inverse">
                {ui[lang].nav.home}
              </a>
              <span aria-hidden="true">/</span>
              <a href={areasHref} class="transition-colors hover:text-fg-on-inverse">
                {t.backToAreas}
              </a>
              <span aria-hidden="true">/</span>
              <span class="text-fg-on-inverse">{area.title}</span>
            </nav>
          </div>
        </div>

        <figcaption class="absolute inset-x-0 bottom-0 z-10">
          <div class="container-x pb-10 pt-28 md:pb-14 md:pt-36">
            <div class="max-w-4xl text-fg-on-inverse">
              <h1 class="font-display text-4xl md:text-6xl leading-[1.02] tracking-[-0.02em] text-fg-on-inverse reveal reveal-from-top">
                {area.title}
              </h1>
              <p class="mt-4 md:mt-6 max-w-3xl text-base md:text-xl leading-relaxed text-fg-on-inverse/80 reveal reveal-fade">
                {area.shortDescription}
              </p>
            </div>
          </div>
        </figcaption>
      </div>
    </figure>
  </section>

  {area.features && area.features.length > 0 && (
    <section class="border-b border-line bg-surface-soft">
      <div class="container-x py-20 md:py-28">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
          <div class="md:col-span-4">
            <div class="md:sticky md:top-32 md:pb-8">
              <p class="eyebrow reveal">{t.featuresEyebrow}</p>
              <h2 class="font-display text-3xl md:text-5xl mt-6 leading-[1.1] reveal">
                {area.featuresTitle}
              </h2>
            </div>
          </div>

          <div class="md:col-span-7 md:col-start-6 reveal">
            <div class="divide-y divide-line border-t border-line">
              {area.features.map((feature) => (
                <PracticeAreaFeatureItem feature={feature} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <CTASection
    title={t.ctaTitle(area.title)}
    description={t.ctaDescription(area.title)}
  />

  <section class="border-t border-line bg-surface-soft">
    <div class="container-x py-20 md:py-28">
      <div class="flex items-end justify-between mb-12">
        <p class="eyebrow">{t.otherAreas}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-20">
        {otherAreas.map((other) => (
          <a
            href={localizePath(`/areas-de-practica/${other.slug}`, lang)}
            class="group block border-t border-line py-8 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-line-strong"
          >
            <h3 class="link-underline [text-decoration-line:underline] font-display text-2xl md:text-4xl leading-[1.05] text-fg transition-colors group-hover:text-fg-accent">
              {other.title}
            </h3>
            <p class="mt-4 max-w-xl text-sm md:text-base leading-relaxed text-fg-muted">
              {other.shortDescription}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
