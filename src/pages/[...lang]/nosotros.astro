---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sheet from "../../components/ui/Sheet.astro";
import Timeline from "../../components/ui/Timeline.astro";
import CTASection from "../../components/CTASection.astro";
import { cms } from "../../lib/cms";
import { getLang, ui } from "../../lib/i18n";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }];
}

const lang = getLang(Astro.url);
const t = ui[lang].about;

const team = await cms.getTeamMembers(lang);

const approachIcons = ["architecture", "handshake", "verified", "query_stats"];

function splitProfileDetail(item: string) {
  const trailingMeta = item.match(/\s*\(([^)]+)\)\s*$/);
  let core = trailingMeta ? item.slice(0, trailingMeta.index).trim() : item;
  const meta: string[] = trailingMeta ? [trailingMeta[1]] : [];

  if (core.includes(" — ")) {
    const [source, detail] = core.split(" — ");
    core = detail.trim();
    meta.unshift(source.trim());
  } else if (core.includes(", ")) {
    const [detail, ...rest] = core.split(", ");
    core = detail.trim();
    meta.unshift(rest.join(", ").trim());
  }

  return {
    core,
    meta: meta.filter(Boolean).join(" · "),
  };
}
---

<BaseLayout title={t.metaTitle} description={t.metaDescription}>
  <!-- ── Hero ────────────────────────────────────────────────── -->
  <section class="container-x pt-20 md:pt-32 pb-16">
    <div class="max-w-5xl">
      <h1 class="font-display text-4xl md:text-6xl leading-[1.05] reveal">
        {t.heroTitle}
      </h1>
    </div>
  </section>

  <!-- ── El equipo ───────────────────────────────────────────── -->
  <section
    class="scroll-background-section scroll-background--surface-soft"
    data-scroll-background
    data-scroll-background-start="top 35%"
    data-scroll-background-end="bottom 30%"
  >
    <div class="container-x py-16 md:py-32">
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-12 sm:gap-x-10 md:gap-y-20">
        {team.map((member) => {
          const sheetId = `sheet-${member.slug}`;
          return (
            <>
            <!-- Card -->
            <article class="flex flex-col reveal">
              <button
                type="button"
                data-sheet-trigger={sheetId}
                class="group w-full text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-line-strong"
                aria-haspopup="dialog"
                aria-controls={sheetId}
              >
                <div class="media-skeleton aspect-[4/5] overflow-hidden rounded-media bg-surface-soft mb-3 md:mb-6">
                  <Image
                    src={member.photo}
                    alt={t.portraitAlt(member.name)}
                    width={700}
                    height={875}
                    format="webp"
                    loading="lazy"
                    data-skeleton
                    class="w-full h-full object-cover transition-transform duration-[560ms] ease-out group-hover:scale-[1.03]"
                  />
                </div>
                <h3 class="link-underline max-md:[text-decoration-line:underline] font-display text-xl md:text-3xl leading-[1.1] group-hover:text-fg-accent transition-colors reveal reveal-from-top">
                  {member.name}
                </h3>
                <p class="mt-1 text-sm text-fg-muted reveal reveal-fade">
                  {member.role}
                </p>
                {member.practiceAreas && member.practiceAreas.length > 0 && (
                  <p class="mt-2 max-md:hidden text-xs text-fg-muted leading-relaxed">
                    {member.practiceAreas.join(" · ")}
                  </p>
                )}
              </button>
            </article>

            <!-- Sheet -->
            <Sheet id={sheetId} label={member.name}>
              <!-- Mobile layout -->
              <div class="md:hidden">
                <div class="flex items-center gap-4" data-sheet-cascade-item>
                  <div class="media-skeleton h-24 w-18 shrink-0 overflow-hidden rounded-media bg-surface-soft">
                    <Image
                      src={member.photo}
                      alt={t.portraitAlt(member.name)}
                      width={200}
                      height={250}
                      format="webp"
                      loading="lazy"
                      data-skeleton
                      class="h-full w-full object-cover"
                    />
                  </div>
                  <div>
                    <p class="text-base text-fg-muted">
                      {member.role}
                    </p>
                    <h2 class="font-display text-3xl leading-[1.1] mt-2">{member.name}</h2>
                  </div>
                </div>

                {member.practiceAreas && member.practiceAreas.length > 0 && (
                  <div class="mt-8" data-sheet-cascade-item>
                    <p class="font-display text-2xl leading-[1.1] text-fg">{t.practiceAreas}</p>
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {member.practiceAreas.map((area) => (
                        <li class="rounded-full border border-line bg-surface-soft px-3 py-1 text-sm text-fg-soft">
                          {area}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {member.experience && member.experience.length > 0 && (
                  <div class="mt-8 pt-8 border-t border-line" data-sheet-cascade-item>
                    <p class="font-display text-2xl leading-[1.1] text-fg">{t.experience}</p>
                    <ul class="mt-4 list-disc space-y-3 pl-5 marker:text-fg-accent">
                      {member.experience.map((item) => {
                        const detail = splitProfileDetail(item);

                        return (
                          <li class="text-sm leading-relaxed">
                            <span class="font-medium text-fg">{detail.core}</span>
                            {detail.meta && (
                              <span class="block text-fg-muted">{detail.meta}</span>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}

                {member.education && member.education.length > 0 && (
                  <div class="mt-8 pt-8 border-t border-line" data-sheet-cascade-item>
                    <p class="font-display text-2xl leading-[1.1] text-fg">{t.education}</p>
                    <Timeline items={[...member.education].reverse()} size="sm" />
                  </div>
                )}

                {member.languages && member.languages.length > 0 && (
                  <div class="mt-8 pt-8 border-t border-line" data-sheet-cascade-item>
                    <p class="font-display text-2xl leading-[1.1] text-fg">{t.languages}</p>
                    <p class="mt-4 text-sm text-fg-soft">{member.languages.join(", ")}</p>
                  </div>
                )}

                {member.memberships && member.memberships.length > 0 && (
                  <div class="mt-8 pt-8 border-t border-line" data-sheet-cascade-item>
                    <p class="font-display text-2xl leading-[1.1] text-fg">{t.memberships}</p>
                    <ul class="mt-4 list-disc space-y-3 pl-5 marker:text-fg-accent">
                      {member.memberships.map((item) => (
                        <li class="text-sm text-fg-soft leading-relaxed">
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {(member.email || member.linkedin) && (
                  <div class="mt-8 pt-8 border-t border-line" data-sheet-cascade-item>
                    <p class="font-display text-2xl leading-[1.1] text-fg">{t.contact}</p>
                    <ul class="mt-4 space-y-3">
                      {member.email && (
                        <li>
                          <a
                            href={`mailto:${member.email}`}
                            class="link-underline text-sm text-fg-soft"
                          >
                            {member.email}
                          </a>
                        </li>
                      )}
                      {member.linkedin && (
                        <li>
                          <a
                            href={member.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-underline text-sm text-fg-soft"
                          >
                            {t.linkedin}
                          </a>
                        </li>
                      )}
                    </ul>
                  </div>
                )}
              </div>

              <!-- Desktop layout (two columns) -->
              <div class="hidden md:grid md:grid-cols-12 md:gap-10 md:min-h-[32rem]">
                <!-- Left: photo + name + role -->
                <div class="md:col-span-3" data-sheet-cascade-item>
                  <div class="media-skeleton aspect-[4/5] overflow-hidden rounded-media bg-surface-soft">
                    <Image
                      src={member.photo}
                      alt={t.portraitAlt(member.name)}
                      width={500}
                      height={625}
                      format="webp"
                      loading="lazy"
                      data-skeleton
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <h2 class="font-display text-2xl leading-[1.15] mt-6">{member.name}</h2>
                  <p class="mt-3 text-base text-fg-muted">
                    {member.role}
                  </p>
                </div>

                <!-- Right: all details -->
                <div class="md:col-span-8 md:col-start-5 overflow-y-auto max-h-[75dvh] pr-3">
                  {member.practiceAreas && member.practiceAreas.length > 0 && (
                    <div data-sheet-cascade-item>
                      <p class="font-display text-3xl leading-[1.05] text-fg">{t.practiceAreas}</p>
                      <ul class="mt-5 flex flex-wrap gap-3">
                        {member.practiceAreas.map((area) => (
                          <li class="rounded-full border border-line bg-surface-soft px-4 py-2 text-base text-fg-soft">
                            {area}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {member.experience && member.experience.length > 0 && (
                    <div class="mt-10 pt-10 border-t border-line" data-sheet-cascade-item>
                      <p class="font-display text-3xl leading-[1.05] text-fg">{t.experience}</p>
                      <ul class="mt-5 list-disc space-y-4 pl-5 marker:text-fg-accent">
                        {member.experience.map((item) => {
                          const detail = splitProfileDetail(item);

                          return (
                            <li class="text-base leading-relaxed">
                              <span class="font-medium text-fg">{detail.core}</span>
                              {detail.meta && (
                                <span class="block text-sm text-fg-muted">{detail.meta}</span>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}

                  {member.education && member.education.length > 0 && (
                    <div class="mt-10 pt-10 border-t border-line" data-sheet-cascade-item>
                      <p class="font-display text-3xl leading-[1.05] text-fg">{t.education}</p>
                    <Timeline items={[...member.education].reverse()} />
                    </div>
                  )}

                  {member.memberships && member.memberships.length > 0 && (
                    <div class="mt-10 pt-10 border-t border-line" data-sheet-cascade-item>
                      <p class="font-display text-3xl leading-[1.05] text-fg">{t.memberships}</p>
                      <ul class="mt-5 list-disc space-y-4 pl-5 marker:text-fg-accent">
                        {member.memberships.map((item) => (
                          <li class="text-base text-fg-soft leading-relaxed">
                            {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {member.languages && member.languages.length > 0 && (
                    <div class="mt-10 pt-10 border-t border-line" data-sheet-cascade-item>
                      <p class="font-display text-3xl leading-[1.05] text-fg">{t.languages}</p>
                      <p class="mt-5 text-base leading-relaxed text-fg-soft">
                        {member.languages.join(" · ")}
                      </p>
                    </div>
                  )}

                  {(member.email || member.linkedin) && (
                    <div class="mt-10 pt-10 border-t border-line" data-sheet-cascade-item>
                      <p class="font-display text-3xl leading-[1.05] text-fg">{t.contact}</p>
                      <ul class="mt-5 space-y-3">
                        {member.email && (
                          <li>
                            <a
                              href={`mailto:${member.email}`}
                              class="link-underline text-base text-fg-soft"
                            >
                              {member.email}
                            </a>
                          </li>
                        )}
                        {member.linkedin && (
                          <li>
                            <a
                              href={member.linkedin}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="link-underline text-base text-fg-soft"
                            >
                              {t.linkedin}
                            </a>
                          </li>
                        )}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </Sheet>
            </>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── Características ─────────────────────────────────────── -->
  <section class="container-x pb-16 md:pb-32">
    <div class="pt-16">
      <div class="mb-16 md:mb-20">
        <p class="eyebrow reveal">{t.approachEyebrow}</p>
        <h2 class="font-display text-3xl md:text-5xl mt-6 leading-[1.1] reveal max-w-3xl">
          {t.approachTitle}
        </h2>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12 md:gap-12">
        {t.approach.map((item, index) => (
          <div class="reveal">
            <span class="material-symbols-sharp text-5xl text-fg-accent leading-none" aria-hidden="true">
              {approachIcons[index]}
            </span>
            <h3 class="font-display text-2xl mt-6 leading-[1.15]">{item.title}</h3>
            <p class="mt-4 text-sm md:text-base text-fg-muted leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────────────── -->
  <CTASection title={t.ctaTitle} description={t.ctaDescription} />
</BaseLayout>
