---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ToastHost from "../components/ui/ToastHost.astro";
import { cms } from "../lib/cms";
import {
  DEFAULT_LANG,
  LANGS,
  getLang,
  isLocalizedRoute,
  switchLocalePath,
  ui,
} from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  headerVariant?: "solid" | "transparent";
  headerAutoHide?: boolean;
}

const lang = getLang(Astro.url);
const t = ui[lang];

const settings = await cms.getSiteSettings(lang);

const {
  title,
  description = settings.tagline,
  ogImage,
  headerVariant = "solid",
  headerAutoHide = true,
} = Astro.props;

const browserSiteName = "Goñi & Cía. Abogados";
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === "/en/";
const pageTitle =
  isHome || !title ? browserSiteName : `${title} | ${browserSiteName}`;
const siteUrl = Astro.site ?? new URL("https://goniabogados.cl");
const canonical = new URL(currentPath, siteUrl).toString();

// Spanish-only pages (publications) advertise no alternates.
const alternates = isLocalizedRoute(currentPath)
  ? LANGS.map((code) => ({
      hreflang: ui[code].htmlLang,
      href: new URL(switchLocalePath(currentPath, code), siteUrl).toString(),
    }))
  : [];
const defaultAlternate = alternates.find(
  (alternate) => alternate.hreflang === ui[DEFAULT_LANG].htmlLang
);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
    )}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600&family=Material+Symbols+Sharp:opsz,wght,FILL,GRAD@20..48,200,0,0&display=swap"
    />

    <!-- Medios pesados (imágenes/videos) viven en estos dominios externos -->
    <link rel="preconnect" href="https://pub-396ba7766f0a49cba86800f9d74523ad.r2.dev" crossorigin />
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-button focus:bg-surface-inverse focus:px-4 focus:py-2 focus:text-fg-on-inverse"
    >
      {t.a11y.skipToContent}
    </a>

    <Header variant={headerVariant} autoHide={headerAutoHide} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <ToastHost />

    <script>
      import { initMediaSkeletons } from "../scripts/media-skeleton";

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );

      function initReveals() {
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      }

      initReveals();
      initMediaSkeletons();

      document.addEventListener("astro:page-load", () => {
        initReveals();
        initMediaSkeletons();
      });
    </script>
  </body>
</html>
